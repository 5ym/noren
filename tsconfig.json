{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    "types": ["bun", "$app/types"],
    // #lib は package.json の imports で解決されるが、svelte-check --tsgo はそれ経由の
    // .svelte の型を拾えず、コンポーネントの props が検査されなくなる。同じ対応を paths にも置く
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  "include": ["src", "tests", "vite.config.ts"]
}

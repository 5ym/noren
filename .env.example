# noren の環境変数。写して .env にし、使うものだけ埋める(空なら、その機能が止まるだけで起動はする)。
# 説明は README の「環境変数」。

# --- 保存先 ------------------------------------------------------------------
# SQLite のファイル(既定 data/noren.db)と、商品の画像・送るファイルの置き場(既定 data/products)
DB_PATH=
PRODUCTS_DIR=
# 最初の起動で見本の商品を入れない
# SAMPLE_PRODUCTS=false

# --- Stripe(オンライン決済。Checkout と Webhook) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- メール(SMTP) -------------------------------------------------------------
# SMTP_HOST が空なら送らず、内容を標準出力に出す
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 平文の SMTP(手元の捕まえ用サーバ)に向けるときだけ false
SMTP_STARTTLS=
# 差出人。空なら「お店の設定」の問い合わせ先
MAIL_FROM=
# 注文の控えの宛先。空なら「お店の設定」の問い合わせ先
SHOP_MAIL_TO=

# --- 管理者・スタッフのログイン(OIDC) ----------------------------------------
# 3 つ揃うと /admin と /staff が開く。IdP の戻り先は <origin>/login/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ロールの値(既定 admin / staff)と、ロールを読む claim(既定は roles と groups)
OIDC_ADMIN_ROLE=
OIDC_STAFF_ROLE=
OIDC_ROLE_CLAIM=
# 既定 "openid profile"
OIDC_SCOPE=

# --- 当日販売の Square POS(任意) --------------------------------------------
SQUARE_APPLICATION_ID=
# 既定 <origin>/staff/square
SQUARE_CALLBACK_URL=

# --- 通知(任意) -------------------------------------------------------------
# Mattermost / Slack の incoming webhook。注文・入金待ち・メールの失敗を流す
NOTIFY_WEBHOOK_URL=
